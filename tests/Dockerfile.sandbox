FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# All system-level (root) installs in a single layer (Sonar docker:S7031):
#   - base tooling: sorted (docker:S7018) + --no-install-recommends (docker:S6500)
#   - Node.js 20 via the NodeSource APT repo, keyring-authenticated — avoids the
#     legacy `curl ... | bash` setup script (docker:S8482)
#   - Claude Code CLI: version-pinned (docker:S8543) + --ignore-scripts so an npm
#     lifecycle script cannot execute during the global install (docker:S6505)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        jq \
        vim \
    && mkdir -p /etc/apt/keyrings \
    && curl --proto "=https" --tlsv1.2 -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g --ignore-scripts @anthropic-ai/claude-code@2.1.156 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace

# Run the test workload as a non-root user (least privilege; Sonar docker:S6471).
# The single root RUN above does all system-level setup (installs + the sandbox
# user, in one layer per docker:S7031); everything below is per-user. This also
# mirrors how `da` runs under a normal user's $HOME, making the sandbox more
# representative.
USER sandbox
# Docker does not set HOME on a USER switch; install.sh writes to $HOME/.local,
# so point it at the sandbox user's home explicitly.
ENV HOME=/home/sandbox
WORKDIR /home/sandbox

# Fetch + integrity-verify the pinned dot-agents installer via ADD --checksum
# (docker:S7026 — declarative fetch with a built-in digest check), then run it
# as the non-root user (install.sh writes only to ~/.local). Bumping the pin is
# a deliberate sandbox rebuild action — keeping the SHA + checksum pinned makes
# the sandbox reproducible and immune to a supply-chain compromise of master.
ARG DOT_AGENTS_INSTALL_SHA=2acb4feb480ef4df28423a8b7c5832f8360d7f86
ARG DOT_AGENTS_INSTALL_CHECKSUM=sha256:8b6c90a42c7c5fc203f39b096024e8926228cf71fdc30c6ace958b32f8aa3505
# --chmod=0644 is required: a remote-URL ADD defaults the destination to mode
# 0600 (root-only), so the non-root sandbox user gets "Permission denied" running
# it (exit 126). 0644 keeps it root-owned and read-only for the sandbox user (no
# write bit → no docker:S6504 "write permissions on the copied resource"), just
# readable so `bash` can execute it. Integrity-pinned by --checksum and consumed
# once; the leftover in /tmp of this ephemeral test image is harmless.
ADD --chmod=0644 --checksum=${DOT_AGENTS_INSTALL_CHECKSUM} \
    "https://raw.githubusercontent.com/AGOrcha/dot-agents/${DOT_AGENTS_INSTALL_SHA}/scripts/install.sh" \
    /tmp/install-dot-agents.sh
RUN bash /tmp/install-dot-agents.sh
ENV PATH="/home/sandbox/.local/bin:$PATH"

# Default workspace (owned by the sandbox user)
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
