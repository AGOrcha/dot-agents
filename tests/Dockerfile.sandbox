FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# All system-level (root) installs in a single layer (Sonar docker:S7031):
#   - base tooling: sorted (docker:S7018) + --no-install-recommends (docker:S6500)
#   - Node.js 20 via the NodeSource APT repo, keyring-authenticated — avoids the
#     legacy `curl ... | bash` setup script (docker:S8482)
#   - Claude Code CLI: version-pinned (docker:S8543) + --ignore-scripts so an npm
#     lifecycle script cannot execute during the global install (docker:S6505)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        jq \
        vim \
    && mkdir -p /etc/apt/keyrings \
    && curl --proto "=https" --tlsv1.2 -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g --ignore-scripts @anthropic-ai/claude-code@2.1.156 \
    && rm -rf /var/lib/apt/lists/*

# Run the test workload as a non-root user (least privilege; Sonar docker:S6471).
# Root above is used only for the system-level installs; everything below is
# per-user. This also mirrors how `da` runs under a normal user's $HOME, making
# the sandbox more representative.
RUN useradd --create-home --shell /bin/bash sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace
USER sandbox
WORKDIR /home/sandbox

# Fetch + integrity-verify the pinned dot-agents installer via ADD --checksum
# (docker:S7026 — declarative fetch with a built-in digest check), then run it
# as the non-root user (install.sh writes only to ~/.local). Bumping the pin is
# a deliberate sandbox rebuild action — keeping the SHA + checksum pinned makes
# the sandbox reproducible and immune to a supply-chain compromise of master.
ARG DOT_AGENTS_INSTALL_SHA=7be7111e5799bd370212fc51f4fc1977f617a9bd
ARG DOT_AGENTS_INSTALL_CHECKSUM=sha256:5c919087d94f0322b75a8890c04700c44ff461bf6923848ce61b937fe3db3652
ADD --chown=sandbox:sandbox --checksum=${DOT_AGENTS_INSTALL_CHECKSUM} \
    "https://raw.githubusercontent.com/NikashPrakash/dot-agents/${DOT_AGENTS_INSTALL_SHA}/scripts/install.sh" \
    /tmp/install-dot-agents.sh
RUN bash /tmp/install-dot-agents.sh && rm /tmp/install-dot-agents.sh
ENV PATH="/home/sandbox/.local/bin:$PATH"

# Default workspace (owned by the sandbox user)
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]
