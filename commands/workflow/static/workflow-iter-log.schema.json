{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/workflow-iter-log.schema.json",
  "title": "da workflow iteration log entry",
  "description": "Schema for .agents/active/iteration-log/iter-N.yaml (schema_version 2). Top-level git and delegation fields are CLI-owned. Nested impl, verifiers[], and review are role-owned: each `workflow checkpoint --log-to-iter N --role …` merge updates only that role's block. `additionalProperties: false` keeps field names stable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "iteration",
    "date",
    "wave",
    "task_id",
    "impl",
    "verifiers",
    "review"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Schema version 2 — role-owned blocks."
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "description": "CLI: monotonically increasing iteration number."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "CLI: date the checkpoint was written (YYYY-MM-DD)."
    },
    "wave": {
      "type": "string",
      "description": "CLI: active plan ID at checkpoint time."
    },
    "task_id": {
      "type": "string",
      "description": "CLI: active task ID from the delegation contract or checkpoint."
    },
    "commit": {
      "type": "string",
      "description": "CLI: git commit SHA at checkpoint time. Empty string if none.",
      "default": ""
    },
    "files_changed": {
      "type": "integer",
      "minimum": 0,
      "description": "CLI: files changed from git diff --stat HEAD~1.",
      "default": 0
    },
    "lines_added": {
      "type": "integer",
      "minimum": 0,
      "description": "CLI: lines added from git diff --stat HEAD~1.",
      "default": 0
    },
    "lines_removed": {
      "type": "integer",
      "minimum": 0,
      "description": "CLI: lines removed from git diff --stat HEAD~1.",
      "default": 0
    },
    "first_commit": {
      "type": "boolean",
      "description": "CLI: true when HEAD~1 does not exist.",
      "default": false
    },
    "agent": {
      "type": "object",
      "description": "CLI: agent identity at checkpoint time — platform harness, version, model, and session reference.",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Platform session UUID (e.g. CLAUDE_CODE_SESSION_ID)."
        },
        "harness": {
          "type": "string",
          "description": "Agent platform harness (claude-code, codex, cursor)."
        },
        "harness_version": {
          "type": "string",
          "description": "Harness version string (semver, e.g. 2.1.138)."
        },
        "model": {
          "type": "string",
          "description": "Model ID used in this session (e.g. claude-sonnet-4-6, gpt-5)."
        },
        "entrypoint": {
          "type": "string",
          "description": "How the session was launched (cli, ide, web)."
        }
      }
    },
    "checkpoint_at": {
      "type": "string",
      "description": "CLI: RFC3339 UTC timestamp when this checkpoint was written.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "session_tokens": {
      "type": "object",
      "description": "CLI: token usage for this iteration, scanned from the active session JSONL and time-windowed by the previous checkpoint_at.",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Total input tokens charged in this iteration."
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Total output tokens generated in this iteration."
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Cache read (prompt cache hit) tokens."
        },
        "cache_creation_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Cache creation (prompt cache write) tokens."
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Reasoning output tokens (Codex o-series only; 0 for Claude Code)."
        },
        "cache_hit_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "CacheReadTokens / (CacheReadTokens + CacheCreationTokens); 0 if not computed."
        },
        "message_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of assistant turns scanned in this iteration."
        }
      }
    },
    "impl": {
      "type": "object",
      "description": "impl-agent / loop-worker contribution. CLI merges AUTO fields; agent-owned fields persist across impl merges.",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "item": { "type": "string", "default": "" },
        "summary": { "type": "string", "default": "" },
        "scope_note": {
          "type": "string",
          "enum": ["on-target", "scope-breach", "partial", ""],
          "default": ""
        },
        "feedback_goal": {
          "type": "string",
          "description": "AUTO from delegation bundle verification.feedback_goal when available.",
          "default": ""
        },
        "retries": { "type": "integer", "minimum": 0, "default": 0 },
        "focused_tests_added": { "type": "integer", "minimum": 0, "default": 0 },
        "focused_tests_pass": {
          "type": ["boolean", "null"],
          "default": null
        },
        "self_assessment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read_loop_state": {
              "type": "boolean",
              "deprecated": true,
              "description": "DEPRECATED — rubber-stamped at ~98% true in historical data (no information). The objective check internal/scoring/objective_checks.go ranCliCommand/readLoopState scans the transcript instead."
            },
            "one_item_only": { "type": ["boolean", "null"] },
            "committed_after_tests": {
              "type": "boolean",
              "deprecated": true,
              "description": "DEPRECATED — rubber-stamped at ~98% true. objective_checks.go committedAfterTests scans the transcript for a test command preceding the commit."
            },
            "aligned_with_canonical_tasks": { "type": ["boolean", "null"] },
            "persisted_via_workflow_commands": {
              "type": "string",
              "default": ""
            },
            "stayed_under_10_files": {
              "type": "boolean",
              "deprecated": true,
              "description": "DEPRECATED — the 10-file threshold was arbitrary; correction_pressure already captures the overload symptoms it was meant to proxy. files_changed remains as raw context."
            },
            "no_destructive_commands": { "type": ["boolean", "null"] },
            "scoped_tests_to_write_scope": { "type": ["boolean", "null"] },
            "tdd_refresh_performed": {
              "type": "boolean",
              "deprecated": true,
              "description": "DEPRECATED — set to true in 0/22 historical entries; carried no signal."
            }
          }
        }
      }
    },
    "verifiers": {
      "type": "array",
      "description": "One entry per verifier type that ran this iteration.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "description": "Verifier slug matching <type>.result.yaml stem."
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "partial", "unknown"],
            "description": "AUTO from verification result artifact.",
            "default": "unknown"
          },
          "gate_passed": {
            "type": "boolean",
            "description": "AUTO: true when status is pass.",
            "default": false
          },
          "tests_added": { "type": "integer", "minimum": 0, "default": 0 },
          "tests_total_pass": { "type": ["boolean", "null"], "default": null },
          "scenario_tags": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "retries": { "type": "integer", "minimum": 0, "default": 0 },
          "result_artifact": {
            "type": "string",
            "description": "Repo-relative path to <type>.result.yaml.",
            "default": ""
          },
          "self_assessment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tests_positive_and_negative": { "type": "boolean", "default": false },
              "tests_used_sandbox": { "type": "boolean", "default": false },
              "exercised_new_scenario": { "type": "boolean", "default": false },
              "ran_cli_command": {
                "type": "boolean",
                "deprecated": true,
                "description": "DEPRECATED — rubber-stamped at ~98% true. objective_checks.go ranCliCommand scans the transcript for a Bash tool_use in the iteration window."
              },
              "cli_produced_actionable_feedback": { "type": "string", "default": "" },
              "linked_traces_to_outcomes": { "type": "boolean", "default": false }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "description": "review-agent contribution; AUTO fields parsed from review-decision.yaml when present.",
      "additionalProperties": false,
      "properties": {
        "phase_1_decision": {
          "type": "string",
          "enum": ["accept", "reject", "escalate", ""],
          "default": ""
        },
        "phase_2_decision": {
          "type": "string",
          "enum": ["accept", "reject", "escalate", ""],
          "default": ""
        },
        "overall_decision": {
          "type": "string",
          "enum": ["accept", "reject", "escalate", ""],
          "default": ""
        },
        "failed_gates": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "escalation_reason": { "type": "string", "default": "" },
        "reviewer_notes": { "type": "string", "default": "" },
        "decision_artifact": {
          "type": "string",
          "description": "Repo-relative path to review-decision.yaml.",
          "default": ""
        },
        "verify_record_appended": {
          "type": "boolean",
          "description": "Set when workflow verify record appends audit evidence (future hook).",
          "default": false
        }
      }
    }
  }
}
