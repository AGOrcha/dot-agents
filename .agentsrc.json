      },
      "eval-fidelity": {
        "label": "Eval/experiment fidelity",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "verifiers/verifier.base.md",
          "verifiers/eval-fidelity.md",
          "verifiers/eval-fidelity.project.md"
        ]
      },
      "integration": {
        "label": "Integration (http/API)",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "verifiers/verifier.base.md",
