{
  "$schema": "https://agorcha.dev/schemas/agentsrc.schema.json",
  "version": 1,
  "project": "dot-agents",
  "skills": [
    "agent-handoff",
    "agent-start",
    "build-graph",
    "review-delta",
    "review-pr",
    "self-review",
    "skill-architect",
    "delegation-lifecycle",
    "iteration-close",
    "loop-worker",
    "orchestrator-session-start",
    "plan-wave-picker",
    "provider-consumer-pair",
    "isp",
    "release-cut",
    "pipeline-architect",
    "research-intake",
    "research-evaluate",
    "knowledge-fold-back",
    "article-extract",
    "playwright",
    "platform-docs-refresh"
  ],
  "rules": [
    "global",
    "project"
  ],
  "agents": [
    "loop-worker",
    "orchestrator",
    "platform-dirs-change-analyst",
    "promise-gap-analyst"
  ],
  "hooks": true,
  "work_tracking": {
    "write_to": "state-ref"
  },
  "mcp": [
    "code-review-graph",
    "sonarqube"
  ],
  "settings": false,
  "sources": [
    {
      "type": "local"
    },
    {
      "type": "git",
      "id": "da-agc",
      "url": "git@github.com:AGOrcha/da-agc.git",
      "ref": "main"
    }
  ],
  "extends": [
    "da-agc:dot-agents/base.json"
  ],
  "packages": [
    "da-agc:skill/release-docs-refresh@main",
    "da-agc:agent/platform-dirs-change-analyst@main",
    "da-agc:agent/promise-gap-analyst@main"
  ],
  "execution_profile": {
    "by_app_type": {
      "daemon": {
        "topology": {
          "executors": 1,
          "verifiers_per_executor": 2,
          "reviewers": "per_verifier",
          "verifier_sequence": [
            "unit",
            "race",
            "integration",
            "comms-contract",
            "auth-proxy-security",
            "kg-integration",
            "load-soak"
          ]
        },
        "lenses": {
          "lens_set": [
            "architecture-standards",
            "adversarial",
            "cross-harness-adversarial",
            "concurrency-safety",
            "security"
          ],
          "lens_concurrency": "gated"
        }
      },
      "docs": {
        "relevance": {
          "review": {
            "core": [
              "architecture-standards",
              "acceptance-invariants"
            ]
          },
          "verify": {
            "core": [
              "verifier"
            ]
          }
        },
        "topology": {
          "executors": 1,
          "verifiers_per_executor": 1,
          "reviewers": "per_executor",
          "verifier_sequence": [
            "schema-check",
            "citation-check",
            "cli-runner"
          ]
        },
        "lenses": {
          "lens_set": [
            "architecture-standards",
            "acceptance-invariants"
          ],
          "lens_concurrency": "parallel"
        }
      },
      "docs/web": {
        "topology": {
          "executors": 1,
          "verifiers_per_executor": 1,
          "reviewers": "per_executor",
          "verifier_sequence": [
            "schema-check",
            "citation-check",
            "link-check",
            "build-site"
          ]
        },
        "lenses": {
          "lens_set": [
            "architecture-standards",
            "acceptance-invariants"
          ],
          "lens_concurrency": "parallel"
        }
      },
      "go-cli": {
        "relevance": {
          "orchestrate": {
            "core": [
              "orchestrator-session-start",
              "plan-wave-picker",
              "loop-worker"
            ],
            "noise": [
              "article-extract",
              "playwright"
            ]
          },
          "review": {
            "core": [
              "thermo-nuclear-code-quality-review",
              "review-pr"
            ],
            "situational": [
              "self-review",
              "review-delta"
            ]
          },
          "verify": {
            "core": [
              "verifier",
              "test-runner"
            ]
          }
        },
        "topology": {
          "executors": 1,
          "verifiers_per_executor": 2,
          "reviewers": "per_verifier",
          "verifier_sequence": [
            "unit",
            "cli-runner"
          ]
        },
        "lenses": {
          "lens_set": [
            "architecture-standards",
            "acceptance-invariants",
            "adversarial",
            "cross-harness-adversarial"
          ],
          "lens_concurrency": "gated"
        }
      },
      "ideation": {
        "relevance": {
          "orchestrate": {
            "core": [
              "kg-ideate",
              "plan-wave-picker"
            ],
            "situational": [
              "article-extract"
            ],
            "noise": [
              "test-runner",
              "loop-worker"
            ]
          },
          "review": {
            "core": [
              "architecture-standards",
              "acceptance-invariants",
              "adversarial"
            ]
          },
          "verify": {
            "core": [
              "verifier"
            ]
          }
        },
        "topology": {
          "executors": 3,
          "verifiers_per_executor": 3,
          "reviewers": "per_executor",
          "verifier_sequence": [
            "schema-check",
            "citation-check",
            "task-schedule"
          ]
        },
        "lenses": {
          "lens_set": [
            "architecture-standards",
            "acceptance-invariants",
            "adversarial"
          ],
          "lens_concurrency": "parallel"
        }
      },
      "meta": {
        "topology": {
          "executors": 1,
          "verifiers_per_executor": 1,
          "reviewers": "per_executor",
          "verifier_sequence": [
            "schema-check",
            "pipeline-lint",
            "eval-fidelity"
          ]
        },
        "lenses": {
          "lens_set": [
            "architecture-standards",
            "acceptance-invariants",
            "adversarial",
            "scientific-method-fidelity"
          ],
          "lens_concurrency": "gated"
        }
      },
      "web": {
        "topology": {
          "executors": 1,
          "verifiers_per_executor": 2,
          "reviewers": "per_verifier",
          "verifier_sequence": [
            "unit",
            "integration",
            "ui-e2e"
          ]
        },
        "lenses": {
          "lens_set": [
            "architecture-standards",
            "acceptance-invariants",
            "adversarial",
            "cross-harness-adversarial",
            "web-a11y"
          ],
          "lens_concurrency": "gated"
        }
      }
    },
    "default_class": "situational"
  },
  "stage_profiles": {
    "executor": {
      "default": {
        "label": "Default implementation executor",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "impl-agent.project.md"
        ]
      }
    },
    "orchestrator": {
      "default": {
        "label": "Default workflow orchestrator",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "isp.prompt.md"
        ]
      }
    },
    "reviewer": {
      "acceptance-invariants": {
        "label": "Acceptance-invariants lens",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "reviewers/reviewer.base.md",
          "reviewers/acceptance-invariants.md",
          "reviewers/acceptance-invariants.project.md"
        ]
      },
      "adversarial": {
        "label": "Adversarial lens",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "reviewers/reviewer.base.md",
