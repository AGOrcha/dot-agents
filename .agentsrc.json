{
  "$schema": "https://agorcha.dev/schemas/agentsrc.schema.json",
  "agents": [
    "loop-worker"
  ],
  "execution_profile": {
    "by_app_type": {
      "go-cli": {
        "relevance": {
          "orchestrate": {
            "core": [
              "orchestrator-session-start",
              "plan-wave-picker",
              "loop-worker"
            ],
            "noise": [
              "article-extract",
              "playwright"
            ]
