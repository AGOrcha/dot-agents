          "reviewers/reviewer.base.md",
          "reviewers/web-a11y.md",
          "reviewers/web-a11y.project.md"
        ]
      }
    },
    "verifier": {
      "auth-proxy-security": {
        "label": "Auth-proxy + secure handling",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "verifiers/verifier.base.md",
          "verifiers/auth-proxy-security.md",
          "verifiers/auth-proxy-security.project.md"
        ]
      },
      "build-site": {
        "label": "Docs-site build",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "verifiers/verifier.base.md",
          "verifiers/build-site.md",
          "verifiers/build-site.project.md"
        ]
      },
      "citation-check": {
        "label": "Citation check (references resolve)",
        "model": "claude-opus-4-8",
        "model_family": "claude",
        "prompt_files": [
          "verifiers/verifier.base.md",
          "verifiers/citation-check.md",
          "verifiers/citation-check.project.md"
        ]
      },
      "cli-runner": {
        "label": "CLI runner (built-binary smoke)",
        "model": "claude-opus-4-8",
