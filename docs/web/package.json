{
  "name": "dot-agents-docs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public docs site for dot-agents — Astro Starlight (content sourced live from docs/**).",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "bash scripts/copy-schemas.sh",
    "build": "npm run build:public && npm run build:internal",
    "build:public": "astro build",
    "build:internal": "INTERNAL_BUILD=1 astro build",
    "merge:internal": "bash scripts/merge-internal.sh",
    "build:merged": "npm run build && npm run merge:internal",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "@mermaid-js/layout-elk": "^0.2.2",
    "astro": "^7.0.6",
    "astro-mermaid": "^2.1.0",
    "cytoscape": "^3.30.2",
    "mermaid": "^11.16.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "miniflare": "^4.20260701.0",
    "serve": "^14.2.4",
    "typescript": "^6.0.3"
  }
}
