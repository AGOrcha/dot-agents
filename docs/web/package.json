{
  "name": "dot-agents-docs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public docs site for dot-agents — Astro Starlight (content sourced live from docs/**).",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "bash scripts/copy-schemas.sh",
    "build": "pnpm run build:public && pnpm run build:internal",
    "build:public": "astro build",
    "build:internal": "INTERNAL_BUILD=1 astro build",
    "merge:internal": "bash scripts/merge-internal.sh",
    "build:merged": "pnpm run build && pnpm run merge:internal",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/starlight": "^0.42.7",
    "@mermaid-js/layout-elk": "^1.0.1",
    "astro": "^7.4.4",
    "astro-mermaid": "^2.2.0",
    "cytoscape": "^3.34.4",
    "mermaid": "^12.2.0",
    "satteri": "^0.11.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "miniflare": "^4.20260730.0",
    "serve": "^14.2.4",
    "typescript": "^7.0.2"
  }
}
