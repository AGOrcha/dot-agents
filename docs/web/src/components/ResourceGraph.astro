---
// Interactive node-link graph rendered with Cytoscape.js. Graph data is
// serialized into a data attribute on the canvas and consumed by a
// bundled client-side script (no define:vars — that prevented Astro
// from processing the script as a module, so the bare `import` of
// `cytoscape` failed to resolve at runtime).
//
// Theme colors for node labels / edges / outlines are read from CSS
// custom properties (--graph-*) at init time and re-applied when the
// theme changes. Starlight flips data-theme="light|dark" on <html> via
// its own toggle, so we watch that attribute with a MutationObserver
// instead of the old custom 'theme-changed' event.
interface GraphNode {
  id: string;
  label: string;
  kind: string;
  // Free-form metadata shown in inspector
  data?: Record<string, unknown>;
}
interface GraphEdge {
  source: string;
  target: string;
  label?: string;
}
interface GraphData {
  nodes: GraphNode[];
  edges: GraphEdge[];
  legend?: { kind: string; color: string; description?: string }[];
}
interface Props {
  graph: GraphData;
  graphId: string;
  layoutName?: string;
}

const { graph, graphId, layoutName = 'cose' } = Astro.props;
const serialized = JSON.stringify({ graph, layoutName });

// Server-rendered accessible + machine-parseable equivalents of the canvas.
// The Cytoscape canvas is opaque to screen readers AND to web-crawling agents
// (the graph lives only inside a <canvas> bitmap + the data-graph attribute),
// so we emit a real text-alternative in the DOM/accessibility tree and a
// compact JSON twin. graphTitle/labelById drive both. (These graph pages are
// custom .astro routes, NOT in the docs collection, so dm4's .md/llms.txt does
// not cover them — the equivalent has to live on the page itself.)
const graphTitle: string = (graph as { title?: string }).title ?? graphId;
const labelById = new Map<string, string>(graph.nodes.map((n) => [n.id, n.label]));
// Minimal structured twin an agent can parse without rendering the canvas. Same
// node/edge data the client script feeds Cytoscape (kept in id/label/kind shape).
const graphJson = JSON.stringify({
  nodes: graph.nodes.map((n) => ({ id: n.id, label: n.label, kind: n.kind })),
  edges: graph.edges.map((e) => ({ source: e.source, target: e.target, label: e.label ?? '' })),
});
---
<div class="graph-page">
  <div
    id={`canvas-${graphId}`}
    class="graph-canvas"
    data-resource-graph
    data-graph-id={graphId}
    data-graph={serialized}
    aria-hidden="true"
  ></div>

  {/* Always-present text alternative: in the DOM + accessibility tree (NOT
      display:none — that would strip it from both SR and rendered-DOM agents).
      Visually de-emphasized via <details> but fully readable when expanded. */}
  <section class="graph-a11y" aria-label={`${graphTitle} — graph data (text)`}>
    <details class="graph-a11y-details">
      <summary>Graph data (text alternative)</summary>
      <p class="graph-a11y-count">
        {graph.nodes.length} nodes, {graph.edges.length} edges.
      </p>
      <h3 id={`a11y-nodes-${graphId}`}>Nodes</h3>
      <ul class="graph-a11y-nodes" aria-labelledby={`a11y-nodes-${graphId}`}>
        {graph.nodes.map((n) => (
          <li data-a11y-node-id={n.id}>
            <strong>{n.label}</strong> <code>{n.id}</code>
            <span class="graph-a11y-kind"> — {n.kind}</span>
          </li>
        ))}
      </ul>
      <h3 id={`a11y-edges-${graphId}`}>Edges</h3>
      <ul class="graph-a11y-edges" aria-labelledby={`a11y-edges-${graphId}`}>
        {graph.edges.map((e) => (
          <li>
            <code>{labelById.get(e.source) ?? e.source}</code> →
            <code>{labelById.get(e.target) ?? e.target}</code>
            {e.label && <span class="graph-a11y-edge-label"> ({e.label})</span>}
          </li>
        ))}
      </ul>
    </details>
    {/* Machine-parseable twin: an agent reads this without the canvas. */}
    <script type="application/json" data-graph-json set:html={graphJson} />
  </section>
  <aside class="graph-inspector" id={`inspector-${graphId}`}>
    {graph.legend && (
      <section class="graph-legend" aria-label="Legend">
        <h3>Legend</h3>
        <ul class="legend-list">
          {graph.legend.map((l) => (
            <li class="legend-item">
              {/* Colored swatch is decorative (the kind name carries the meaning
                  as real text), so it's hidden from a11y and exempt from text
                  contrast — the prior colored-fill pill failed WCAG AA contrast
                  for mid-tone kinds (white-on-#f59e0b ≈ 2.1:1). */}
              <span class="legend-swatch" style={`background:${l.color}`} aria-hidden="true"></span>
              <span class="legend-kind">{l.kind}</span>
              {l.description && <span class="legend-desc"> — {l.description}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}
    <section class="graph-detail" id={`detail-${graphId}`} aria-label="Selected node">
      <h3>Selected node</h3>
      <p class="hint">Click a node to view its details.</p>
    </section>
  </aside>
</div>

<script>
  import cytoscape from 'cytoscape';

  type CyInstance = ReturnType<typeof cytoscape>;
  type MountedGraph = {
    el: HTMLElement;
    detail: HTMLElement | null;
    graphId: string;
    graph: any;
    layoutName: string;
    cy?: CyInstance;
  };

  const mounted: MountedGraph[] = [];

  function readThemeColors(): Record<string, string> {
    const cs = getComputedStyle(document.documentElement);
    const v = (name: string, fallback: string) => {
      const raw = cs.getPropertyValue(name).trim();
      return raw || fallback;
    };
    return {
      label: v('--graph-label', '#e5edf7'),
      labelOutline: v('--graph-label-outline', '#0b1220'),
      nodeBorder: v('--graph-node-border', '#0b1220'),
      nodeSelected: v('--graph-node-selected', '#f59e0b'),
      edge: v('--graph-edge', '#3b4d77'),
      edgeLabel: v('--graph-edge-label', '#8aa0c0'),
      edgeLabelBg: v('--graph-edge-label-bg', '#0b1220'),
    };
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderDetail(detail: HTMLElement, node: any, kindColors: Record<string, string>, defaultColor: string) {
    const d = node.data();
    const payload = d.payload ?? {};
    const rows = Object.entries(payload)
      .map(([k, v]) => {
        let value;
        if (Array.isArray(v)) {
          value = v.map((x) => `<span class="badge">${escapeHtml(String(x))}</span>`).join(' ');
        } else if (typeof v === 'object' && v !== null) {
          value = `<pre style="white-space:pre-wrap; font-size:0.78rem; margin:0;">${escapeHtml(JSON.stringify(v, null, 2))}</pre>`;
        } else {
          value = escapeHtml(String(v));
        }
        return `<dt>${escapeHtml(k)}</dt><dd>${value}</dd>`;
      })
      .join('');
    detail.innerHTML = `
      <h3>${escapeHtml(d.label)}</h3>
      <dl>
        <dt>Kind</dt><dd><span class="badge" style="background:${kindColors[d.kind] ?? defaultColor}">${escapeHtml(d.kind)}</span></dd>
        <dt>ID</dt><dd><code>${escapeHtml(d.id)}</code></dd>
        ${rows}
      </dl>
    `;
  }

  function resetDetail(detail: HTMLElement) {
    detail.innerHTML = '<h3>Selected node</h3><p class="hint">Click a node to view its details.</p>';
  }

  function buildStyle(kindColors: Record<string, string>, defaultColor: string): any[] {
    const t = readThemeColors();
    return [
      {
        selector: 'node',
        style: {
          'background-color': (ele: any) => kindColors[ele.data('kind')] ?? defaultColor,
          label: 'data(label)',
          color: t.label,
          'font-size': 11,
          'text-outline-color': t.labelOutline,
          'text-outline-width': 2,
          'text-valign': 'center',
          'text-halign': 'center',
          'text-wrap': 'wrap',
          'text-max-width': 90,
          width: 'label',
          height: 'label',
          padding: '10px',
          shape: 'round-rectangle',
          'border-width': 1,
          'border-color': t.nodeBorder,
        },
      },
      {
        selector: 'node:selected',
        style: {
          'border-color': t.nodeSelected,
          'border-width': 3,
        },
      },
      {
        selector: 'edge',
        style: {
          width: 1.4,
          'line-color': t.edge,
          'target-arrow-color': t.edge,
          'target-arrow-shape': 'triangle',
          'curve-style': 'bezier',
          label: 'data(label)',
          'font-size': 9,
          color: t.edgeLabel,
          'text-rotation': 'autorotate',
          'text-background-color': t.edgeLabelBg,
          'text-background-opacity': 0.8,
          'text-background-padding': 2,
        },
      },
    ];
  }

  function mountGraph(canvas: HTMLElement) {
    const graphId = canvas.getAttribute('data-graph-id') ?? '';
    const raw = canvas.getAttribute('data-graph');
    if (!raw) return;
    const detail = document.getElementById(`detail-${graphId}`);
    const { graph, layoutName } = JSON.parse(raw);

    const kindColors: Record<string, string> = Object.fromEntries(
      (graph.legend ?? []).map((l: any) => [l.kind, l.color]),
    );
    const defaultColor = '#64748b';

    const elements = [
      ...graph.nodes.map((n: any) => ({
        data: { id: n.id, label: n.label, kind: n.kind, payload: n.data ?? {} },
      })),
      ...graph.edges.map((e: any, i: number) => ({
        data: {
          id: `e${i}`,
          source: e.source,
          target: e.target,
          label: e.label ?? '',
        },
      })),
    ];

    const cy = cytoscape({
      container: canvas,
      elements,
      style: buildStyle(kindColors, defaultColor),
      layout: layoutName === 'breadthfirst'
        ? { name: 'breadthfirst', directed: true, padding: 24, spacingFactor: 1.25 }
        : { name: 'cose', padding: 24, animate: false, nodeRepulsion: 8000, idealEdgeLength: 110 },
      wheelSensitivity: 0.2,
    });

    if (detail) {
      cy.on('tap', 'node', (evt: any) => renderDetail(detail, evt.target, kindColors, defaultColor));
      cy.on('tap', (evt: any) => {
        if (evt.target === cy) {
          resetDetail(detail);
        }
      });
    }

    // Expose the rendered node-id set so the e2e parity test can assert the
    // machine-parseable JSON twin (data-graph-json) matches what Cytoscape
    // actually rendered — guarding against the visual and the agent-readable
    // form drifting apart.
    const w = window as unknown as { __cyNodes?: Record<string, string[]> };
    w.__cyNodes = w.__cyNodes || {};
    w.__cyNodes[graphId] = cy.nodes().map((n: any) => n.id());

    mounted.push({ el: canvas, detail, graphId, graph, layoutName, cy });
  }

  function initAll() {
    const canvases = Array.from(document.querySelectorAll<HTMLElement>('[data-resource-graph]'));
    for (const canvas of canvases) {
      // Defer one animation frame so the container has measured size; Cytoscape
      // refuses to render into a 0×0 container and a layout-engine-during-init
      // race can leave the canvas blank if the parent grid hasn't resolved.
      requestAnimationFrame(() => mountGraph(canvas));
    }
  }

  // Re-init all mounted graphs against the new theme palette. We rebuild the
  // style array (function-based color resolvers are baked in at .style() time).
  function onThemeChange() {
    for (const m of mounted) {
      if (!m.cy) continue;
      const kindColors: Record<string, string> = Object.fromEntries(
        (m.graph.legend ?? []).map((l: any) => [l.kind, l.color]),
      );
      m.cy.style(buildStyle(kindColors, '#64748b'));
    }
  }

  // Starlight's theme toggle flips the `data-theme` attribute on <html>; watch
  // it and re-apply the cytoscape palette whenever the theme changes. (The old
  // custom 'theme-changed' event from the bespoke ThemeToggle is gone.)
  function watchTheme() {
    const observer = new MutationObserver((records) => {
      for (const r of records) {
        if (r.attributeName === 'data-theme') {
          onThemeChange();
          break;
        }
      }
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }

  watchTheme();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

<style>
  /* Structural styles live HERE (in the component that emits the matching DOM)
     rather than on the host page: Astro scopes styles per-component, so a
     page-level `.graph-canvas` rule would NOT apply to this component's div and
     the canvas would collapse to 0 height — Cytoscape then renders nothing.
     --graph-* are read by the client script at init / on theme change; mapped
     onto Starlight's --sl-color-* tokens so the palette tracks light/dark. */
  :global(:root) {
    --graph-label: var(--sl-color-white);
    --graph-label-outline: var(--sl-color-black);
    --graph-node-border: var(--sl-color-gray-5);
    --graph-node-selected: var(--sl-color-orange-high, #f59e0b);
    --graph-edge: var(--sl-color-gray-4);
    --graph-edge-label: var(--sl-color-gray-3);
    --graph-edge-label-bg: var(--sl-color-black);
  }

  .graph-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: 1rem;
    align-items: start;
  }

  .graph-canvas {
    width: 100%;
    height: clamp(28rem, 70vh, 44rem);
    min-height: 28rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
  }

  .graph-inspector {
    position: sticky;
    top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.9rem;
  }

  /* Text alternative / agent-readable region. Spans the full grid so it sits
     below the canvas + inspector. Stays in the DOM and the accessibility tree
     (never display:none); <details> keeps it visually compact by default. */
  .graph-a11y {
    grid-column: 1 / -1;
    font-size: 0.9rem;
  }

  .graph-a11y-details > summary {
    cursor: pointer;
    font-weight: 600;
    /* gray-2 on the page background clears WCAG AA contrast (axe checks this). */
    color: var(--sl-color-gray-2);
  }

  .graph-a11y-count {
    margin: 0.5rem 0;
    color: var(--sl-color-gray-2);
  }

  .graph-a11y-nodes,
  .graph-a11y-edges {
    margin: 0 0 0.75rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .graph-a11y-kind,
  .graph-a11y-edge-label {
    color: var(--sl-color-gray-2);
  }

  .graph-legend h3,
  .graph-detail h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .legend-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .legend-item {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  /* Decorative color chip (aria-hidden); meaning is in the adjacent text. */
  .legend-swatch {
    flex: 0 0 auto;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 0.25rem;
    /* outline keeps low-luminance chips visible on the dark canvas-side panel */
    border: 1px solid var(--sl-color-gray-5);
    align-self: center;
  }

  .legend-kind {
    font-weight: 600;
    /* gray-1 body text on the page bg clears WCAG AA (axe-verified). */
    color: var(--sl-color-gray-1);
  }

  .legend-desc {
    color: var(--sl-color-gray-2);
  }

  .graph-detail .hint {
    color: var(--sl-color-gray-3);
    font-style: italic;
  }

  .graph-detail :global(dl) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 0.75rem;
    margin: 0;
  }

  .graph-detail :global(dt) {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }

  .graph-detail :global(dd) {
    margin: 0;
    word-break: break-word;
  }

  :global(.badge) {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.75rem;
    color: #fff;
    background: var(--sl-color-gray-4);
  }

  @media (max-width: 50rem) {
    .graph-page {
      grid-template-columns: minmax(0, 1fr);
    }
    .graph-inspector {
      position: static;
    }
  }
</style>
