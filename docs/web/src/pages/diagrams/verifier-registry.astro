---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ResourceGraph from '../../components/ResourceGraph.astro';
import graph from '../../data/verifier-registry.json';
---
<StarlightPage frontmatter={{ title: graph.title, description: graph.description }}>
  <p>{graph.description}</p>
  <ResourceGraph graph={graph} graphId="verifier-registry" layoutName={graph.layout} />
</StarlightPage>
