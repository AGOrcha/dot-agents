---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ResourceGraph from '../../components/ResourceGraph.astro';
import graph from '../../data/lens-dispatch.json';
---
<StarlightPage frontmatter={{ title: graph.title, description: graph.description }}>
  <p>{graph.description}</p>
  <ResourceGraph graph={graph} graphId="lens-dispatch" layoutName={graph.layout} />
</StarlightPage>
