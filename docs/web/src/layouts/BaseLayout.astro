---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { title, description = 'dot-agents — interactive docs', currentPath } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — dot-agents</title>
  </head>
  <body>
    <div class="layout">
      <Sidebar currentPath={currentPath ?? Astro.url.pathname} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
