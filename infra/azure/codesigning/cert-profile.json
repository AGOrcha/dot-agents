{
    "$schema": "http://schema.management.azure.com/schemas/2014-04-01-preview/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "accountName": {
            "type": "string",
            "defaultValue": "AGOrcha",
            "metadata": {
                "description": "Name of the existing Microsoft.CodeSigning account."
            }
        },
        "profileName": {
            "type": "string",
            "defaultValue": "agorcha-public-trust",
            "metadata": {
                "description": "Certificate profile name. This is the value to set as the TRUSTED_SIGNING_PROFILE repo variable."
            }
        },
        "profileType": {
            "type": "string",
            "defaultValue": "PublicTrust",
            "allowedValues": [
                "PublicTrust",
                "PublicTrustTest",
                "PrivateTrust",
                "PrivateTrustCIPolicy",
                "VBSEnclave"
            ],
            "metadata": {
                "description": "Public Trust is required to distribute .exe to the public; PublicTrustTest chains to a Microsoft test root for a dry run (do not distribute test-signed binaries)."
            }
        },
        "identityValidationId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Id of the COMPLETED identity validation (copy from the portal — Identity validations pane; there is no CLI/ARM list API). Required for all trust profile types; an empty value is rejected as 'IdentityValidationId property value is invalid', including for PublicTrustTest."
            }
        }
    },
    "resources": [
        {
            "type": "Microsoft.CodeSigning/codesigningaccounts/certificateProfiles",
            "apiVersion": "2025-10-13",
            "name": "[concat(parameters('accountName'), '/', parameters('profileName'))]",
            "properties": {
                "profileType": "[parameters('profileType')]",
                "identityValidationId": "[parameters('identityValidationId')]"
            }
        }
    ],
    "outputs": {
        "profileName": {
            "type": "string",
            "value": "[parameters('profileName')]"
        }
    }
}
