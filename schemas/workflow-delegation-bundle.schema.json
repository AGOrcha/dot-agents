{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/workflow-delegation-bundle.schema.json",
  "title": "da workflow delegation bundle",
  "description": "Repo-local JSON Schema for .agents/active/delegation-bundles/<delegation-id>.yaml. Models the persisted worker/profile/prompt/context/verification payload paired with a delegation contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delegation_id",
    "plan_id",
    "task_id",
    "owner",
    "worker",
    "scope",
    "prompt",
    "context",
    "verification",
    "closeout"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "delegation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "slice_id": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "project_overlay_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_by": {
          "type": "string",
          "minLength": 1
        },
        "selected_at": {
          "type": "string",
          "description": "RFC3339 timestamp"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write_scope"],
      "properties": {
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prompt_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_goal"],
      "properties": {
        "feedback_goal": {
          "type": "string",
          "minLength": 1
        },
        "scenario_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regression_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "higher_layer_validation_queue": {
          "type": "string",
          "minLength": 1
        },
        "focused_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regression_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "app_type": {
          "type": "string",
          "minLength": 1,
          "description": "Resolved task or plan default_app_type used with app_type_verifier_map"
        },
        "verifier_sequence": {
          "type": "array",
          "description": "Ordered verifier profile ids from --verifier-sequence or .agentsrc.json app_type_verifier_map",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Resolved model route for this task, read from execution_profile.by_app_type[app_type].model on the same path that resolves verifier_sequence. An open ref (bare tier alias like 'sonnet', or provider-qualified like 'anthropic:claude-opus-4-8'). Omitted when the app_type pins no model — absence means the worker's harness default applies, never a fabricated model. See .agents/proposals/model-facet-apptypeprofile.md.",
          "$comment": "Additive optional field; existing bundles without it stay valid."
        },
        "evidence_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_negative_coverage": {
              "type": "boolean"
            },
            "sandbox_mutations": {
              "type": "boolean",
              "description": "When true, the verifier may exercise mutation paths in a sandbox AND the adversarial review lens may run active mutation-based probing instead of read-only inspection. See adversarial-reviewer AGENT.md."
            },
            "verifier_chain_max": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry budget for the verifier chain. Replaces the deprecated primary_chain_max."
            },
            "lens_chain_max": {
              "type": "integer",
              "minimum": 1,
              "description": "Per-lens retry budget for the lens-sequenced review path. Separate from verifier_chain_max so verifier and lens budgets do not silently share a knob."
            },
            "primary_chain_max": {
              "type": "integer",
              "minimum": 1,
              "deprecated": true,
              "description": "DEPRECATED: alias for verifier_chain_max retained for one release cycle. Bundles using this key trigger a deprecation warning on load. Use verifier_chain_max instead."
            }
          }
        }
      }
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker_must": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "workflow_verify_record",
              "workflow_checkpoint",
              "workflow_merge_back"
            ]
          }
        },
        "parent_must": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "workflow_advance",
              "workflow_delegation_closeout"
            ]
          }
        }
      }
    }
  }
}
