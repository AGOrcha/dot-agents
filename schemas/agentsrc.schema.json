{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/agentsrc.schema.json",
  "title": "dot-agents project manifest",
  "description": "Repo-local schema for .agentsrc.json. Accepts both v1 and v2 of the manifest surface. v1 omits the v2 additive fields (repo_id, extends, packages, features, and the Source.id/cache_ttl/auth + http/oci source types). All v2 fields are optional so a v1 file continues to validate against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "Schema version. 1 = legacy surface; 2 = surface that activates the v2 additive fields."
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "$ref": "#/$defs/stringList"
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "global",
          "project"
        ]
      }
    },
    "agents": {
      "$ref": "#/$defs/stringList"
    },
    "hooks": {
      "$ref": "#/$defs/stringsOrBool"
    },
    "mcp": {
      "$ref": "#/$defs/stringsOrBool"
    },
    "settings": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "kg": {
      "type": "object",
      "description": "Knowledge-graph configuration for this project",
      "additionalProperties": false,
      "properties": {
        "graph_home": {
          "type": "string",
          "description": "Path to KG_HOME. Overrides KG_HOME env var."
        },
        "backend": {
          "type": "string",
          "enum": ["sqlite", "postgres"],
          "description": "Storage backend. 'postgres' requires KG_POSTGRES_URL."
        },
        "bridge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether bridge queries are active for this project"
            },
            "allowed_intents": {
              "$ref": "#/$defs/stringList",
              "description": "If non-empty, restricts bridge to this intent set"
            }
          }
        }
      }
    },
    "verifier_profiles": {
      "type": "object",
      "description": "Named verifier profiles referenced by app_type_verifier_map and workflow fanout",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "prompt_files": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "app_type_verifier_map": {
      "type": "object",
      "description": "Maps app_type strings to ordered verifier profile ids for fanout bundle resolution",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refresh": {
      "type": "object",
      "description": "Latest da install/refresh metadata recorded on the project.",
      "additionalProperties": false,
      "required": ["version", "commit", "describe", "refreshedAt"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "examples": ["v1.0.0"]
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "examples": ["ad213s5e"]
        },
        "describe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "examples": ["Refreshed dot-agents project from ~/.agents/ into project directories."]
        },
        "refreshedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "examples": ["2026-04-13T12:59:35Z"]
        }
      }
    },
    "repo_id": {
      "type": "string",
      "minLength": 1,
      "description": "v2: canonical repository identity (e.g. 'github.com/acme/manager-ui'). Protected: imported layers cannot override it."
    },
    "extends": {
      "type": "array",
      "description": "v2: ordered list of config layer references. Each entry is either a string 'source-id:layer-path[@version]' or an object with optional flag.",
      "items": {
        "$ref": "#/$defs/layerRef"
      }
    },
    "packages": {
      "type": "array",
      "description": "v2: ordered list of executable package references 'source-id:artifact-path@version-spec'.",
      "items": {
        "$ref": "#/$defs/packageRef"
      }
    },
    "features": {
      "type": "object",
      "description": "v2: feature-flag overrides keyed by feature name.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringsOrBool": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/stringList"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "local",
            "git",
            "http",
            "oci"
          ],
          "description": "v2: http and oci added per config-distribution-model §4. v1 files declaring only local/git remain valid."
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "v2: stable local identifier used in extends/packages refs."
        },
        "cache_ttl": {
          "type": "string",
          "minLength": 1,
          "description": "v2: tier-1 cache TTL duration (e.g. '4h'). Ignored for oci sources."
        },
        "auth": {
          "type": "object",
          "description": "v2: opaque auth block. Schema owned by external-agent-sources spec; treated as pass-through here."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "git"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "http"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "oci"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "layerRef": {
      "description": "v2: extends entry. Either a plain reference string 'source-id:layer-path[@version]' or an object with optional flag.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+:[^@\\s]+(@[^\\s]+)?$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.-]+:[^@\\s]+(@[^\\s]+)?$"
            },
            "optional": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "packageRef": {
      "description": "v2: packages entry. Reference string 'source-id:artifact-path@version-spec' or object form.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.-]+:[^@\\s]+@[^\\s]+$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.-]+:[^@\\s]+@[^\\s]+$"
            }
          }
        }
      ]
    }
  }
}
