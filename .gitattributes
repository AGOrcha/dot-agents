# Enforce LF line endings in the working tree on every platform.
# Without this, GitHub Windows runners check out with core.autocrlf=true,
# converting all text files to CRLF — which makes `gofmt -l` flag every
# .go file and fails the Windows CI job.
* text=auto eol=lf

*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sh    text eol=lf
*.bash  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
