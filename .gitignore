# git worktree directories — embed pointer files, not real content;
# `git add -A` would otherwise warn about adding embedded git repos
# and silently create broken submodule-like entries.
.agents/worktrees/

research/articles/images/

# macOS
.AppleDouble
.LSOverride
Icon

# Python
*.py[cod]
__pycache__/
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt

# Ralph loop NDJSON captures (bin/tests/ralph-cursor-loop)
.ralph-loop-streams/

# Shell scripts
*.sh~

# SonarQube/SonarCloud scanner working dir — generated during the
# SonarQube Scan step; must be ignored or GoReleaser aborts the release
# with "git is in a dirty state".
.scannerwork/

# Archives
*.zip
*.tar.gz
*.rar

# R1 outcome-scoring sidecars — derived artifacts produced by `da score run`.
# Regenerated from iter-N.yaml + git topology + (optional) transcripts, so
# committing them would pin a snapshot that drifts from the rubric/inputs.
.agents/active/iteration-log/*.score.yaml
# Per-worktree CRG Python venv symlink (see venv-symlink-into-worktrees lesson) — never commit
.venv

# terraform plan outputs
*.tfplan
